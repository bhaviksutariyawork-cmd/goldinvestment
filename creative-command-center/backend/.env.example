# Copy to backend/.env. Every variable is prefixed CCC_.

CCC_MONGODB_URI=mongodb://localhost:27017
CCC_MONGODB_DB=creative_command_center

# Protects Meta access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it the app runs but refuses to store a token.
CCC_TOKEN_ENCRYPTION_KEY=

CCC_META_API_VERSION=v21.0
CCC_BACKFILL_DAYS=90
CCC_REFRESH_DAYS=7
CCC_SYNC_INTERVAL_HOURS=4
CCC_ENABLE_SCHEDULER=true

CCC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
